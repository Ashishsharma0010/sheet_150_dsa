// Remove Outermost Parentheses

#include<bits/stdc++.h>
using namespace std;
class solution{
    public:
    string validpranthesis(string s){
        string ans="";
         int count=0;
         for(int i=0; i<s.length(); i++){
             if(s[i]=='('){
                 if(count>0){
                     ans.push_back(s[i]);
                     
                 }
                 count++;
             }
             else{ //s[i]==')';
             count--;
             
                 if(count>0){
                     ans.push_back(s[i]);
                 }
             }
             
         }
         return ans;
        
    }
};
int main(){
    solution obj;
   string s;
   cin>>s;
   string result=obj.validpranthesis(s);
   
    cout<<result;
}


// Q: Reverse Words in a String

#include<bits/stdc++.h>
using namespace std;
class solution{
    public:
    string reverse_words(string s){
        string ans="";
        reverse(s.begin(),s.end());
        for(int i=0; i<s.length(); i++){
            string words="";
            while(i<s.length() && s[i]!=' '){
                words=words+s[i];
                i++;
            }
            reverse(words.begin(),words.end());
            if(words.length()>0){
            ans=ans+" "+words;
            }
        }
        return ans.substr(1);
            
        
    }
};
int main(){
    solution obj;
    
    string s;
    getline(cin,s);
    string ans=obj.reverse_words(s);
    cout<<ans;
}
time complexity of this is O(N);
Space complexity of this code is O(N);

// Q: Longest Common Prefix

#include<bits/stdc++.h>
using namespace std;
class solution{
    public:
    string commonprefix(vector<string> strs){
        sort(strs.begin(),strs.end());
        string first=strs[0];
        string last=strs[strs.size()-1];
        string ans="";
        for(int i=0; i<min(first.size(),last.size()); i++){
            if(first[i]==last[i]){
                ans+=first[i];
            }
            else
            break;
        }
         return ans;
    }
   
    
};
int main(){
    solution ob;
    vector<string> strs={"flower", "flow", "flight"};
    cout<<ob.commonprefix(strs);
    return 0;
}

// ROTATE STRING

#include<bits/stdc++.h>
using namespace std;
class solution{
public:
bool rotate_strings(string a,string goal){
    int n=a.size();
    int m=goal.size();
    if(n!=m){
        return false;
    }
    if(a==goal){
        return true;
    }
    if((a+a).find(goal)!=string::npos){
        return true;
    }
    return false;
}
};
int main(){
    solution obj;
    string a;
    cin>>a;
    string goal;
    cin>>goal;
    cout<<obj.rotate_strings(a,goal);
}

// Valid anagram

#include<bits/stdc++.h>
using namespace std;
class solution{
    public:
    bool anagram(string s,string p){
        int n=s.size();
        int m=p.size();
        if(n!=m){
            return false;
        }
        sort(s.begin(),s.end());
        sort(p.begin(),p.end());
        if(s!=p){
            return false;
        }
        return true;
    }
};
int main(){
    solution obj;
    string s;
    cin>>s;
    string p;
    cin>>p;
    bool a=obj.anagram(s,p);
    cout<<a;
    return 0;
}

// Twosum;

#include<bits/stdc++.h>
using namespace std;
vector<int> twosum(vector<int>& arr,int target){
map<int,int> mp;
int n=arr.size();
for(int i=0; i<n; i++){
int need=target-arr[i];
if(mp.find(need)!=mp.end()){
  return {mp[need],i};
}
mp[arr[i]]=i;
}
return {-1,-1};
}


int main(){ // main function
int n;
cin>>n;
vector<int> arr(n);
for(int i=0; i<n; i++){
cin>>arr[i];
}
int target;
cin>>target;
vector<int> ans=twosum(arr,target);
if(ans.size()==2){
cout<<ans[0]<<" "<<ans[1];
}
else{
return 0;
}
}




