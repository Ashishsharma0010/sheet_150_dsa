// Remove Outermost Parentheses

#include<bits/stdc++.h>
using namespace std;
class solution{
    public:
    string validpranthesis(string s){
        string ans="";
         int count=0;
         for(int i=0; i<s.length(); i++){
             if(s[i]=='('){
                 if(count>0){
                     ans.push_back(s[i]);
                     
                 }
                 count++;
             }
             else{ //s[i]==')';
             count--;
             
                 if(count>0){
                     ans.push_back(s[i]);
                 }
             }
             
         }
         return ans;
        
    }
};
int main(){
    solution obj;
   string s;
   cin>>s;
   string result=obj.validpranthesis(s);
   
    cout<<result;
}


// Q: Reverse Words in a String

#include<bits/stdc++.h>
using namespace std;
class solution{
    public:
    string reverse_words(string s){
        string ans="";
        reverse(s.begin(),s.end());
        for(int i=0; i<s.length(); i++){
            string words="";
            while(i<s.length() && s[i]!=' '){
                words=words+s[i];
                i++;
            }
            reverse(words.begin(),words.end());
            if(words.length()>0){
            ans=ans+" "+words;
            }
        }
        return ans.substr(1);
            
        
    }
};
int main(){
    solution obj;
    
    string s;
    getline(cin,s);
    string ans=obj.reverse_words(s);
    cout<<ans;
}
time complexity of this is O(N);
Space complexity of this code is O(N);




